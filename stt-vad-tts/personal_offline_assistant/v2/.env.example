# Copy to .env (never commit .env). All optional.
# Groq dev-bridge brain (E2E testing while LFM2.5 is not wired in):
GROQ_API_KEY=gsk_...
# LangChain agent brain (brain.type: langchain) — OpenAI-compatible endpoint:
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=lfm2.5
LLM_API_KEY=no-key-required
# Conversation summarizer (each defaults to the LLM_* value):
# SUMMARY_MODEL=
# SUMMARY_BASE_URL=
# SUMMARY_API_KEY=
# Telegram send tool: message @BotFather -> /newbot -> token; then message your
# bot once from the recipient account below.
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_USERNAME=your_telegram_username
# Web search tool (Tavily):
TAVILY_API_KEY=tvly-...
